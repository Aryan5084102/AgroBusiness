# --- AgriFlow ERP — root stack environment (docker compose) ---
# Copy to .env before running `docker compose up`. Never commit a real .env.

# Postgres
POSTGRES_USER=agriflow
POSTGRES_PASSWORD=agriflow
POSTGRES_DB=agriflow

# Backend
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-insecure-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Object storage (MinIO)
S3_ACCESS_KEY=agriflow
S3_SECRET_KEY=agriflow-secret
S3_BUCKET=agriflow
S3_REGION=us-east-1

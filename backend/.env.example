# --- AgriFlow ERP backend environment ---
# Copy to .env for local development. NEVER commit a real .env.

ENVIRONMENT=development
DEBUG=true
APP_NAME=AgriFlow ERP

# Datastores (defaults match docker-compose service names when run in Docker)
DATABASE_URL=postgresql+asyncpg://agriflow:agriflow@localhost:5432/agriflow
REDIS_URL=redis://localhost:6379/0

# Security — generate a strong value for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# CORS (comma-separated). Must list the frontend's exact origin — credentials
# are sent with every request, so "*" is not accepted by browsers.
CORS_ORIGINS=http://localhost:3000

# Auth cookies. Leave as-is when the frontend shares the API's hostname.
# When it lives on its own domain (Vercel/Netlify/a second Render service) that
# is a cross-site caller: set COOKIE_SAMESITE=none, which requires HTTPS.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true    # defaults to true in production or when samesite=none

# Object storage (MinIO locally, S3-compatible in production)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=agriflow
S3_SECRET_KEY=agriflow-secret
S3_BUCKET=agriflow
S3_REGION=us-east-1

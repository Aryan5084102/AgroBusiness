# --- AgriFlow ERP backend environment ---
# Copy to .env for local development. NEVER commit a real .env.

ENVIRONMENT=development
DEBUG=true
APP_NAME=AgriFlow ERP

# Datastores (defaults match docker-compose service names when run in Docker)
DATABASE_URL=postgresql+asyncpg://agriflow:agriflow@localhost:5432/agriflow
REDIS_URL=redis://localhost:6379/0

# Security — generate a strong value for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Object storage (MinIO locally, S3-compatible in production)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=agriflow
S3_SECRET_KEY=agriflow-secret
S3_BUCKET=agriflow
S3_REGION=us-east-1

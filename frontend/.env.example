# --- AgriFlow ERP frontend environment ---
# Only NEXT_PUBLIC_* values reach the browser. Never put secrets here.

# Where Next proxies /api/* to, server-side. The browser never sees this and
# never makes a cross-origin request, so the backend's CORS_ORIGINS and cookie
# SameSite settings stop mattering for this frontend.
API_PROXY_TARGET=http://localhost:8000

# Show the one-click demo-account panel on the login page. Unset follows the
# build type (visible under `next dev`, hidden in a production build), so a
# hosted demo must set this to 'true' explicitly. Only enable it where the
# backend was seeded with demo data — it publishes working credentials.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
